{
  // The game engine must run unchanged in both windows and in tests, so it
  // is checked without browser (DOM) or Node.js definitions: any use of
  // window, document, localStorage, fs, etc. fails to compile here.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/engine"],
  "exclude": ["src/engine/**/*.test.ts"]
}
